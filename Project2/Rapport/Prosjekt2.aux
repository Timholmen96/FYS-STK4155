\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The index convention for the equations below, seen from a single node $a_j^{(l)}$. The node $j$ in layer $l$ collects the outputs $a_i^{(l-1)}$ of all $M_{l-1}$ nodes in the previous layer, weighted by $w_{ij}^{(l)}$, adds its own bias $b_j^{(l)}$ to form the pre-activation $z_j^{(l)}$, and applies its activation function $\sigma $ to obtain $a_j^{(l)}$, which it then sends on to every node of layer $l+1$ through the weights $w_{jk}^{(l+1)}$.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:Indexconvention}{{1}{4}{The index convention for the equations below, seen from a single node $a_j^{(l)}$. The node $j$ in layer $l$ collects the outputs $a_i^{(l-1)}$ of all $M_{l-1}$ nodes in the previous layer, weighted by $w_{ij}^{(l)}$, adds its own bias $b_j^{(l)}$ to form the pre-activation $z_j^{(l)}$, and applies its activation function $\sigma $ to obtain $a_j^{(l)}$, which it then sends on to every node of layer $l+1$ through the weights $w_{jk}^{(l+1)}$}{figure.1}{}}
